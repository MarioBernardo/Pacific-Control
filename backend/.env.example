# Flask/PostgreSQL
FLASK_ENV=development
FLASK_DEBUG=false
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/pacific_control
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Redis, cache and operational sessions
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
OPERATIVE_SESSION_TTL=43200
DEVICE_LINK_TTL=2592000
REQUIRE_REDIS_OPERATIVE_SESSION=true
ALLOW_LEGACY_OPERATIVE_DEVICES=false

# Novelty evidence
NOVEDAD_UPLOAD_FOLDER=uploads/novedades
MAX_NOVEDAD_PHOTO_BYTES=5242880

# ASISTENTE PACIFIC (server-side only)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_SECONDS=20
